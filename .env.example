# Copy to .env and fill in. Every tunable lives here — no hardcoded values in code.

# --- Database (RDS Postgres 16 + pgvector; endpoint + credentials come from the CDK data stack / Secrets Manager) ---
# Local dev can use a full URL. Hosted runtime should prefer the discrete
# DATABASE_* values so DATABASE_PASSWORD can come from Secrets Manager.
DATABASE_URL=postgres://oracle:CHANGE_ME@localhost:5432/oracle
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=oracle
DATABASE_USER=oracle
DATABASE_PASSWORD=
# TLS mode for the pg client: require (RDS) | disable (local dev only)
DATABASE_SSL=require

# --- Oracle open-data sources (public IPFS, no credentials) ---
# Query-table Parquet: one file, 511,695 Lee County rows, 37 columns.
ORACLE_QUERY_TABLE_IPNS=k51qzi5uqu5djd4ohcf3qm87dhlt0e270xw8ejhkyia62edr76uj0u05hrf7m5
# Shard index for the consolidated per-property JSON dataset (52 shards).
ORACLE_SHARD_INDEX_IPNS=k51qzi5uqu5dlzgslzedrnk4whtd7ip69l0pmd3zxelz8hwjorbeyy0pyyeu4m
# Gateways rotated in order on 429/5xx/timeouts.
IPFS_GATEWAYS=https://ipfs.io,https://dweb.link,https://w3s.link,https://ipfs.filebase.io

# --- Ingest artifacts (gitignored) ---
INGEST_DATA_DIR=.data
INGEST_PARQUET_FILE=lee-county.parquet

# --- Ingest tuning ---
INGEST_FETCH_CONCURRENCY=12
INGEST_FETCH_RETRIES=5
INGEST_FETCH_BACKOFF_MS=2000
INGEST_FETCH_TIMEOUT_MS=60000
INGEST_LOAD_BATCH_SIZE=1000
# Parallel workers for the `stage` transform.
INGEST_STAGE_WORKERS=6

# --- Bedrock (embeddings + answers) via the Vercel AI SDK ---
# Credentials resolve via the AWS provider chain (AWS_PROFILE / SSO / role).
AWS_PROFILE=
AWS_REGION=us-east-2
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Must equal the entity_documents.embedding column dimension (vector(512)).
EMBED_DIMS=512
EMBED_BATCH=192
EMBED_CONCURRENCY=8
ANSWER_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Logging ---
LOG_LEVEL=info
